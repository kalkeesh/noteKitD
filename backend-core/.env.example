# Local development can use mongodb://localhost:27017.
# Vercel/production must use a cloud URI, for example MongoDB Atlas:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB_NAME=NOTEkiT
JWT_SECRET=replace-with-at-least-32-characters
APP_ENV=development
REQUIRE_DB_ON_STARTUP=false
BUDGETIFY_API_BASE_URL=https://notekit-budgetify-backend.vercel.app
EMAIL_ENABLED=false
EMAIL_USER=
EMAIL_PASS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
AI_TIMEOUT_SECONDS=20
