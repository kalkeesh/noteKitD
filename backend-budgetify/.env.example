# Local development can use mongodb://localhost:27017.
# Vercel/production must use a cloud URI, for example MongoDB Atlas:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB_NAME=NOTEkiT
JWT_SECRET=replace-with-at-least-32-characters
APP_ENV=development
REQUIRE_DB_ON_STARTUP=false
